<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core'daki arayuzlerin GERCEK uygulamalari: Windows seslendirme (WinRT), NAudio (mikrofon + hoparlor),
       Whisper.net (konusma tanima), Serilog (log). Windows 10 SDK hedefi Windows.Media.SpeechSynthesis icin. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechApp.Core\SpeechApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- whisper.cpp'nin Windows DLL'leri: normal (AVX'li islemci) ve AVX'siz eski islemciler icin -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

</Project>
