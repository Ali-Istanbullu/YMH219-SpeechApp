<Project Sdk="Microsoft.NET.Sdk">

  <!-- SpeechApp.exe: pencere, genel hata yakalayici ve siniflarin birbirine baglanmasi (DI). Mantik Core'da. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>SpeechApp</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechApp.Core\SpeechApp.Core.csproj" />
    <ProjectReference Include="..\SpeechApp.Infrastructure\SpeechApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpeechApp.SmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <!-- Gelistirme: repo kokundeki model\ klasorune indirilen model (repoya girmez) cikti klasorune kopyalanir.
       Kurulumda model, kurulum programi tarafindan {app}\model'e indirilir. -->
  <ItemGroup Condition="Exists('..\..\model\ggml-small-q8_0.bin')">
    <None Include="..\..\model\ggml-small-q8_0.bin" Link="model\ggml-small-q8_0.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
